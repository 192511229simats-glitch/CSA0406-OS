#include <stdio.h>
int main()
{
int n, start, i, record:
printf("Enter number of records: ");
scanf("%d", &n);
printf("Enter starting block number: ");
scanf("%d", &start);
printf("\nFile Allocation:\n");
for(i = 0; i < n; i++)
{
printf("Record %d -> Block %d\n", i + 1, start + i);
}
printf("\nEnter record number to access: ");
scanf("%d", &record);
if(record < 1 || record > n)
{
printf("Invalid record number");
}
else
{
printf("\nAccessing Record %d:\n", record);
for(i = 1; i <= record; i++)
{
printf("Reading Record %d\n", i);
}
printf("\nRecord %d accessed successfully.\n", record);
}
return 0;
}


