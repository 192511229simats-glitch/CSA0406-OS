#include<stdio.h>
int main()
{
    int n,i,bt[10],wt[10],tat[10];
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&bt[i]);
    wt[0]=0;
    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];
    for(i=0;i<n;i++)
        tat[i]=wt[i]+bt[i];
    printf("BT WT TAT\n");
    for(i=0;i<n;i++)
        printf("%d %d %d\n",bt[i],wt[i],tat[i]);
}


input:
3
5 3 2

output:
BT WT TAT
5 0 5
3 5 8
2 8 10
