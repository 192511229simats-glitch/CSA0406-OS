#include<stdio.h>
int main()
{
    int n,i,j,t,bt[10],wt[10],tat[10];
    scanf("%d",&n);
    for(i=0;i<n;i++) scanf("%d",&bt[i]);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(bt[i]>bt[j])
            {
                t=bt[i];
                bt[i]=bt[j];
                bt[j]=t;
            }
    wt[0]=0;
    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];
    for(i=0;i<n;i++)
        tat[i]=wt[i]+bt[i];\
    printf("BT WT TAT\n");
    for(i=0;i<n;i++)
        printf("%d %d %d\n",bt[i],wt[i],tat[i]);
}

input:
4
6 8 2 4

output:
BT WT TAT
2 0 2
4 2 6
6 6 12
8 12 20
