#include<stdio.h>
int main()
{
    int n,i,j,bt[10],p[10],t;
    scanf("%d",&n);
    for(i=0;i<n;i++)
        scanf("%d%d",&bt[i],&p[i]);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(p[i]>p[j])
            {
                t=p[i]; p[i]=p[j]; p[j]=t;
                t=bt[i]; bt[i]=bt[j]; bt[j]=t;
            }
    printf("Order:\n");
    for(i=0;i<n;i++)
        printf("P%d ",i+1);
}

