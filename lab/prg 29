#include<stdio.h>
#include<pthread.h>
#include<semaphore.h>

int x;
sem_t e,f;

void*producer(){
 sem_wait(&e); x=10; printf("Produced: %d\n",x); sem_post(&f);
}
void*consumer(){
 sem_wait(&f); printf("Consumed: %d\n",x); sem_post(&e);
}
int main(){
 pthread_t a,b; sem_init(&e,0,1);sem_init(&f,0,0);
 pthread_create(&a,0,producer,0);pthread_create(&b,0,consumer,0);
 pthread_join(a,0);pthread_join(b,0);
}

input:
No input

output:
Produced: 10
Consumed: 10
