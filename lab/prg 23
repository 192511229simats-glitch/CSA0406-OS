#include<stdio.h>
int main(){
 int b[20],p[20],n,m,i,j;
 scanf("%d",&n);
 for(i=0;i<n;i++)scanf("%d",&b[i]);
 scanf("%d",&m);
 for(i=0;i<m;i++)scanf("%d",&p[i]);
 for(i=0;i<m;i++){
  for(j=0;j<n;j++)
   if(b[j]>=p[i]){printf("P%d -> B%d\n",i+1,j+1);b[j]-=p[i];break;}
  if(j==n)printf("P%d -> Not Allocated\n",i+1);
 }
}

input:
3
100 500 200
2
180 400

output:
P1 -> B2
P2 -> Not Allocated
