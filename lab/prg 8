#include<stdio.h>
int main()
{
int n,q,i,t=0,b[10],r[10];
scanf("%d%d",&n,&q);
for(i=0;i<n;i++) scanf("%d",&b[i]),r[i]=b[i];
while(1)
{
int f=1;
for(i=0;i<n;i++)
if(r[i])
{
f=0;
if(r[i]>q)t+=q,r[i]-=q;
else t+=r[i],printf("P%d=%d\n",i+1,t),r[i]=0;
}
if(f)break;
}
}

input:
3 2
10 5 8

output:
P2=13
P3=21
P1=23
