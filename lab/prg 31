#include<stdio.h>
int main(){
 int a[20],f[10],n,m,i,j,k=0,p=0,hit;
 scanf("%d",&m);
 for(i=0;i<m;i++)f[i]=-1;
 scanf("%d",&n);
 for(i=0;i<n;i++){
  scanf("%d",&a[i]); hit=0;
  for(j=0;j<m;j++)if(f[j]==a[i])hit=1;
  if(!hit){f[k]=a[i];k=(k+1)%m;p++;}
 }
 printf("Page Faults = %d",p);
}

input:
3
1 2 3 1 4 5

output:
Page Faults = 5
