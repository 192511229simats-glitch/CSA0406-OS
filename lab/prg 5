#include<stdio.h>
int main()
{
    int n,i,j,t,bt[10],p[10],wt[10],tat[10];
    scanf("%d",&n);
    for(i=0;i<n;i++)
        scanf("%d%d",&bt[i],&p[i]);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(p[i]>p[j])
            {
                t=p[i]; p[i]=p[j]; p[j]=t;
                t=bt[i]; bt[i]=bt[j]; bt[j]=t;
            }
    wt[0]=0;
    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];
    for(i=0;i<n;i++)
        tat[i]=wt[i]+bt[i];
    printf("BT P WT TAT\n");
    for(i=0;i<n;i++)
        printf("%d %d %d %d\n",bt[i],p[i],wt[i],tat[i]);
}

input:
4
5 3
3 1
4 2
2 4

output:
BT P WT TAT
3 1 0 3
4 2 3 7
5 3 7 12
2 4 12 14
