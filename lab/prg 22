#include<stdio.h>
int main(){
 int b[20],p[20],n,m,i,j,best;
 scanf("%d",&n);
 for(i=0;i<n;i++)scanf("%d",&b[i]);
 scanf("%d",&m);
 for(i=0;i<m;i++)scanf("%d",&p[i]);
 for(i=0;i<m;i++){
  best=-1;
  for(j=0;j<n;j++)
   if(b[j]>=p[i]&&(best==-1||b[j]<b[best]))best=j;
  if(best!=-1){printf("P%d -> B%d\n",i+1,best+1);b[best]-=p[i];}
  else printf("P%d -> Not Allocated\n",i+1);
 }
}

input:
3
100 500 200
2
180 400

output:
P1 -> B3
P2 -> B2
